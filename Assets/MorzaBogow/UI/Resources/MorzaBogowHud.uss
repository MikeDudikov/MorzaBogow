/* Morza Bogów – battle interface, after the interface package (design-tokens.json, MorzaHud.uss).
   Laid out on 1920×1080; the panel scales it evenly and by the player's 90–125% setting. */

.hud-root {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    color: rgb(243, 234, 214);
    -unity-font-definition: url("Hud/Fonts/SourceSans3-Regular.ttf");
    font-size: 18px;
}

.title { -unity-font-definition: url("Hud/Fonts/Cinzel-SemiBold.ttf"); letter-spacing: 0.5px; color: rgb(243, 234, 214); }
.strong { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); }
.body { font-size: 18px; white-space: normal; }
.small { font-size: 16px; color: rgb(199, 199, 183); }
.num { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 24px; -unity-text-align: middle-right; }
.bronze { color: rgb(190, 161, 108); }
.warn { color: rgb(228, 185, 105); }
.bad { color: rgb(241, 132, 108); }
.good { color: rgb(154, 184, 106); }
.spacer { flex-grow: 1; }
.glyph { width: 26px; height: 26px; min-width: 26px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.glyph-small { width: 20px; height: 20px; min-width: 20px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }

.frame-panel { background-image: url("Hud/Frames/panel.png"); -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64; -unity-slice-scale: 0.5px; }
.frame-parchment { background-image: url("Hud/Frames/parchment.png"); -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64; -unity-slice-scale: 0.5px; }
.frame-herald { background-image: url("Hud/Frames/herald.png"); -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64; -unity-slice-scale: 0.4px; }

/* ---------- Top bar (44 px) ---------- */

.topbar {
    position: absolute; top: 0; left: 0; right: 0; height: 44px;
    padding-left: 16px; padding-right: 16px;
    flex-direction: row; align-items: center;
    background-color: rgba(12, 27, 33, 0.98);
    border-bottom-width: 1px; border-bottom-color: rgb(150, 127, 82);
}
.topbar-ornament {
    position: absolute; left: 0; right: 0; bottom: -7px; height: 6px;
    background-image: url("Hud/Ornaments/meander.png"); -unity-background-scale-mode: scale-and-crop;
    background-repeat: repeat-x; background-size: 48px 6px; opacity: 0.55;
}
.wordmark { flex-direction: row; align-items: center; min-width: 228px; margin-right: 12px; }
.wordmark-label { font-size: 20px; margin-left: 8px; }
.res {
    flex-direction: row; align-items: center; height: 40px; margin-right: 10px; padding-left: 8px; padding-right: 8px;
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 3px; color: rgb(243, 234, 214);
}
.res:hover { background-color: rgba(190, 161, 108, 0.14); }
.res-label { font-size: 18px; margin-left: 8px; margin-right: 6px; }
.res-value { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 24px; min-width: 58px; -unity-text-align: middle-right; }
.res-cap { font-size: 16px; color: rgb(199, 199, 183); margin-left: 4px; min-width: 48px; }
.res-flash { color: rgb(228, 185, 105); }
.res-short { color: rgb(241, 132, 108); }
.top-stat { flex-direction: row; align-items: center; margin-left: 14px; }
.top-stat-value { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 22px; margin-left: 6px; }
.top-stat-small { font-size: 16px; color: rgb(199, 199, 183); margin-left: 4px; }
.top-button {
    width: 34px; height: 34px; margin-left: 10px; padding: 4px;
    background-color: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgba(190, 161, 108, 0.0); border-radius: 3px;
}
.top-button:hover { border-color: rgba(190, 161, 108, 0.6); background-color: rgba(190, 161, 108, 0.12); }
.top-button:focus { border-color: rgb(228, 185, 105); }
.top-button.active { border-color: rgb(228, 185, 105); background-color: rgba(228, 185, 105, 0.18); }
.top-button-glyph { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; }
.speed-label { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 20px; width: 40px; -unity-text-align: middle-center; }
.divider { width: 1px; height: 26px; margin-left: 12px; margin-right: 4px; background-color: rgba(190, 161, 108, 0.35); }

/* ---------- Port selector, groups, hint ---------- */

.port-selector {
    position: absolute; top: 60px; left: 50%; translate: -50% 0; height: 40px;
    flex-direction: row; align-items: center; padding-left: 14px; padding-right: 14px;
    background-color: rgba(16, 35, 41, 0.96); border-width: 1px; border-color: rgb(163, 138, 86); border-radius: 3px;
    color: rgb(243, 234, 214);
}
.port-selector:hover { border-color: rgb(228, 185, 105); }
.port-name { font-size: 18px; margin-left: 8px; margin-right: 8px; -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); }

.groups { position: absolute; top: 60px; left: 16px; flex-direction: row; }
.group-chip {
    flex-direction: row; align-items: center; height: 40px; padding-left: 10px; padding-right: 10px; margin-right: 6px;
    background-color: rgba(16, 35, 41, 0.92); border-width: 1px; border-color: rgba(163, 138, 86, 0.8); border-radius: 3px;
}
.group-chip:hover { border-color: rgb(228, 185, 105); }
.group-chip-number { font-size: 16px; color: rgb(199, 199, 183); margin-right: 8px; }
.group-chip-count { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 20px; margin-left: 6px; }

.command-hint {
    position: absolute; top: 112px; left: 50%; translate: -50% 0;
    flex-direction: row; align-items: center; padding: 6px 16px 6px 10px;
    background-color: rgba(11, 20, 24, 0.94); border-width: 1px; border-color: rgb(228, 185, 105); border-radius: 3px;
}
.command-hint-title { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 18px; margin-left: 8px; }
.command-hint-text { font-size: 16px; color: rgb(199, 199, 183); margin-left: 10px; }

/* ---------- Herald (max 4) ---------- */

.herald { position: absolute; top: 60px; right: 16px; width: 333px; }
.herald-item {
    flex-direction: row; align-items: center; min-height: 64px; margin-bottom: 8px; padding: 10px 14px 10px 12px;
    background-color: rgba(16, 30, 35, 0.97); border-left-width: 4px; border-left-color: rgb(190, 161, 108); border-radius: 2px;
}
.herald-item:hover { background-color: rgba(35, 54, 59, 0.98); }
.herald-item.important { border-left-color: rgb(228, 185, 105); }
.herald-item.critical { border-left-color: rgb(241, 132, 108); background-color: rgba(40, 22, 20, 0.97); }
.herald-icon {
    width: 36px; height: 36px; min-width: 36px; margin-right: 12px; border-radius: 18px;
    border-width: 1px; border-color: rgba(190, 161, 108, 0.7); padding: 6px;
}
.herald-item.critical .herald-icon { border-color: rgb(241, 132, 108); }
.herald-icon-glyph { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; }
.herald-text { flex-grow: 1; flex-shrink: 1; }
.herald-title { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 18px; white-space: normal; }
.herald-sub { font-size: 16px; color: rgb(199, 199, 183); white-space: normal; }
.herald-key { font-size: 16px; color: rgb(228, 185, 105); margin-left: 8px; }

/* ---------- Bottom band (194 px) ---------- */

.bottom-band {
    position: absolute; left: 0; right: 0; bottom: 0; height: 194px;
    flex-direction: row; padding: 13px 20px 14px 20px;
    background-color: rgba(11, 22, 27, 0.97);
    border-top-width: 1px; border-top-color: rgb(150, 127, 82);
}
.band-ornament {
    position: absolute; left: 0; right: 0; top: -8px; height: 7px;
    background-image: url("Hud/Ornaments/wave.png"); background-repeat: repeat-x; background-size: 56px 7px; opacity: 0.5;
}
.section { min-width: 0; }
.section-heading { flex-direction: row; align-items: center; height: 30px; margin-bottom: 4px; }
.section-title { -unity-font-definition: url("Hud/Fonts/Cinzel-SemiBold.ttf"); font-size: 20px; color: rgb(243, 234, 214); }
.section-note { font-size: 16px; color: rgb(199, 199, 183); margin-left: 12px; }
.small-button {
    width: 28px; height: 28px; padding: 4px; margin-left: 6px;
    background-color: rgba(150, 130, 85, 0.15); border-width: 1px; border-color: rgba(190, 161, 108, 0.45); border-radius: 3px;
}
.small-button:hover { background-color: rgba(190, 161, 108, 0.3); }
.small-button:focus { border-color: rgb(228, 185, 105); }
.small-button-glyph { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; }

.minimap-section { width: 222px; margin-right: 18px; }
.minimap { height: 135px; border-width: 1px; border-color: rgb(150, 130, 85); }

.selection-section { flex-grow: 1; flex-shrink: 1; padding-left: 18px; margin-right: 18px; border-left-width: 1px; border-left-color: rgba(143, 128, 80, 0.35); }
.selection-content { flex-grow: 1; flex-direction: row; align-items: center; overflow: hidden; }

.portrait {
    width: 124px; height: 124px; min-width: 124px; margin-right: 18px;
    background-color: rgba(35, 54, 59, 0.9); border-width: 1px; border-color: rgba(190, 161, 108, 0.7); border-radius: 3px;
    -unity-background-scale-mode: scale-to-fit;
}
.portrait.enemy { border-color: rgb(241, 132, 108); }
.portrait-badge { position: absolute; left: 4px; top: 4px; width: 26px; height: 26px; -unity-background-scale-mode: scale-to-fit; }
.card { flex-grow: 1; flex-shrink: 1; }
.card-name { -unity-font-definition: url("Hud/Fonts/Cinzel-SemiBold.ttf"); font-size: 22px; }
.card-tag { font-size: 16px; color: rgb(241, 132, 108); margin-left: 12px; }
.card-row { flex-direction: row; align-items: center; margin-top: 4px; }
.card-meter { height: 12px; flex-grow: 1; margin-left: 10px; margin-right: 10px; }
.card-value { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 20px; min-width: 96px; -unity-text-align: middle-right; }
.card-stat { flex-direction: row; align-items: center; margin-right: 16px; }
.card-button {
    margin: 0 0 0 auto; padding: 1px 10px; font-size: 16px; color: rgb(243, 234, 214);
    background-color: rgba(35, 54, 59, 0.95); border-width: 1px; border-color: rgba(190, 161, 108, 0.8); border-radius: 3px;
}
.card-button:hover, .card-button:focus { border-color: rgb(228, 185, 105); background-color: rgba(52, 76, 82, 0.95); }
.card-stat-value { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 20px; margin-left: 6px; }
.card-stat-label { font-size: 16px; color: rgb(199, 199, 183); margin-left: 4px; }
.card-phase { font-size: 18px; color: rgb(228, 185, 105); margin-top: 6px; white-space: normal; }

.group-cards { flex-direction: row; flex-shrink: 0; }
.unit-card {
    width: 92px; height: 124px; margin-right: 8px; padding: 4px; align-items: center; flex-shrink: 0;
    background-color: rgba(35, 54, 59, 0.85); border-width: 1px; border-color: rgba(190, 161, 108, 0.6); border-radius: 3px;
}
.unit-card:hover { border-color: rgb(228, 185, 105); }
.unit-card:focus { border-color: rgb(243, 234, 214); }
.unit-portrait { width: 82px; height: 76px; -unity-background-scale-mode: scale-to-fit; }
.unit-name { font-size: 16px; -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); margin-top: 2px; }
.unit-meter { width: 76px; height: 5px; margin-top: 3px; }
.more-card { width: 64px; height: 124px; flex-shrink: 0; margin-right: 8px; justify-content: center; align-items: center; background-color: rgba(35, 54, 59, 0.6); border-width: 1px; border-color: rgba(190, 161, 108, 0.6); border-radius: 3px; }
.more-label { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 22px; }
.group-summary { margin-left: 16px; flex-shrink: 1; justify-content: center; }
.class-count { flex-direction: row; align-items: center; margin-top: 4px; }

.help-line { font-size: 16px; color: rgb(199, 199, 183); white-space: normal; margin-top: 4px; }

/* ---------- Production ---------- */

.production-section { width: 346px; padding-left: 18px; margin-right: 18px; border-left-width: 1px; border-left-color: rgba(143, 128, 80, 0.35); }
.queue-row { height: 62px; flex-direction: row; align-items: center; }
.queue-label { width: 78px; align-items: flex-start; }
.queue-label-text { font-size: 16px; color: rgb(199, 199, 183); }
.queue-items { flex-grow: 1; flex-direction: row; align-items: center; }
.queue-item {
    width: 56px; height: 56px; margin-right: 6px; padding: 3px;
    background-color: rgba(35, 54, 59, 0.9); border-width: 1px; border-color: rgba(190, 161, 108, 0.6); border-radius: 3px;
}
.queue-item:hover { border-color: rgb(228, 185, 105); }
.queue-item:focus { border-color: rgb(243, 234, 214); border-width: 2px; }
.queue-item.current { border-color: rgb(228, 185, 105); }
.queue-glyph { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; }
.queue-stage { position: absolute; left: 2px; top: 2px; width: 18px; height: 18px; -unity-background-scale-mode: scale-to-fit; }
.queue-time { position: absolute; right: 2px; bottom: 6px; font-size: 14px; -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); text-shadow: 0 1px 2px rgb(0, 0, 0); }
.queue-bar { position: absolute; left: 2px; right: 2px; bottom: 1px; height: 4px; }
.queue-add {
    width: 30px; height: 30px; padding: 6px;
    background-color: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgba(190, 161, 108, 0.45); border-radius: 15px;
}
.queue-add:hover { background-color: rgba(190, 161, 108, 0.25); }
.queue-empty { font-size: 16px; color: rgb(199, 199, 183); margin-right: 8px; }

/* ---------- Commands 4×3 ---------- */

.commands-section { width: 420px; padding-left: 18px; border-left-width: 1px; border-left-color: rgba(143, 128, 80, 0.35); }
.command-grid { flex-direction: row; flex-wrap: wrap; }
.command {
    width: 23%; height: 44px; margin-right: 2%; margin-bottom: 5px; padding-left: 6px; padding-right: 6px;
    flex-direction: column; align-items: center; justify-content: center;
    background-image: url("Hud/Frames/button-normal.png"); -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64; -unity-slice-scale: 0.25px;
    background-color: rgba(0, 0, 0, 0); border-width: 0; color: rgb(243, 234, 214);
}
.command:hover { background-image: url("Hud/Frames/button-hover.png"); }
.command:active { background-image: url("Hud/Frames/button-pressed.png"); }
.command:focus { background-image: url("Hud/Frames/button-hover.png"); }
.command.selected { background-image: url("Hud/Frames/button-selected.png"); }
.command.disabled { background-image: url("Hud/Frames/button-disabled.png"); color: rgb(150, 150, 140); }
.command-glyph { width: 20px; height: 20px; min-width: 20px; min-height: 20px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.command-label { font-size: 15px; margin-top: -1px; -unity-text-align: middle-center; }
.hotkey { position: absolute; right: 5px; top: 1px; font-size: 13px; color: rgb(212, 192, 144); }
.commands-empty { font-size: 16px; color: rgb(199, 199, 183); white-space: normal; }

/* ---------- Collapsed ---------- */

.restore-button {
    position: absolute; right: 16px; bottom: 16px; height: 40px; flex-direction: row; align-items: center; padding-left: 12px; padding-right: 14px;
    background-color: rgba(16, 35, 41, 0.96); border-width: 1px; border-color: rgb(163, 138, 86); border-radius: 3px;
}
.restore-label { margin-left: 8px; font-size: 16px; }

/* ---------- Popovers, tooltip, modals ---------- */

.popover-layer, .modal-layer, .world-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.popover {
    position: absolute; min-width: 260px; padding: 12px 16px 14px 16px;
    background-color: rgba(16, 30, 35, 0.98); border-width: 1px; border-color: rgb(163, 138, 86); border-radius: 3px;
}
.popover-title { -unity-font-definition: url("Hud/Fonts/Cinzel-SemiBold.ttf"); font-size: 20px; margin-bottom: 8px; }
.popover-row { flex-direction: row; align-items: center; min-height: 30px; }
.popover-row-label { flex-grow: 1; font-size: 18px; }
.popover-row-value { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 18px; min-width: 120px; -unity-text-align: middle-right; }
.popover-note { font-size: 16px; color: rgb(199, 199, 183); white-space: normal; margin-top: 6px; }
.menu-item {
    flex-direction: row; align-items: center; height: 40px; padding-left: 10px; padding-right: 10px; margin-top: 2px;
    background-color: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgba(0, 0, 0, 0); border-radius: 3px; color: rgb(243, 234, 214);
}
.menu-item:hover { background-color: rgba(190, 161, 108, 0.16); border-color: rgba(190, 161, 108, 0.5); }
.menu-item:focus { border-color: rgb(228, 185, 105); }
.menu-item.disabled { color: rgb(130, 130, 120); }
.menu-item.chosen { border-color: rgb(228, 185, 105); }
.menu-item-label { flex-grow: 1; margin-left: 10px; font-size: 18px; }
.menu-item-value { font-size: 16px; color: rgb(199, 199, 183); }

.tooltip {
    position: absolute; max-width: 360px; padding: 12px 16px 14px 16px;
    background-color: rgba(11, 20, 24, 0.98); border-width: 1px; border-color: rgb(163, 138, 86); border-radius: 3px;
}
.tooltip-title { -unity-font-definition: url("Hud/Fonts/SourceSans3-SemiBold.ttf"); font-size: 18px; }
.tooltip-body { font-size: 16px; white-space: normal; color: rgb(214, 210, 196); margin-top: 4px; }
.tooltip-cost { font-size: 16px; color: rgb(228, 185, 105); margin-top: 6px; white-space: normal; }
.tooltip-key { font-size: 16px; color: rgb(190, 161, 108); margin-top: 4px; }

.modal-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(5, 10, 12, 0.6); align-items: center; justify-content: center; }
.modal {
    width: 600px; padding: 22px 28px 22px 28px;
    background-color: rgba(16, 30, 35, 0.99); border-width: 1px; border-color: rgb(190, 161, 108); border-radius: 3px;
}
.modal.wide { width: 900px; }
.modal-title { -unity-font-definition: url("Hud/Fonts/Cinzel-SemiBold.ttf"); font-size: 24px; margin-bottom: 10px; }
.modal-text { font-size: 18px; white-space: normal; margin-bottom: 12px; }
.button-row { flex-direction: row; justify-content: flex-end; margin-top: 12px; }
.text-button {
    height: 44px; min-width: 150px; margin-left: 10px; padding-left: 18px; padding-right: 18px; justify-content: center; align-items: center;
    background-image: url("Hud/Frames/button-normal.png"); -unity-slice-left: 64; -unity-slice-right: 64; -unity-slice-top: 64; -unity-slice-bottom: 64; -unity-slice-scale: 0.25px;
    background-color: rgba(0, 0, 0, 0); border-width: 0; color: rgb(243, 234, 214); font-size: 18px;
}
.text-button:hover { background-image: url("Hud/Frames/button-hover.png"); }
.text-button:focus { background-image: url("Hud/Frames/button-selected.png"); }
.text-button.primary { background-image: url("Hud/Frames/button-selected.png"); }
.text-button.danger { color: rgb(241, 132, 108); }
.tabs { flex-direction: row; margin-bottom: 12px; border-bottom-width: 1px; border-bottom-color: rgba(190, 161, 108, 0.4); }
.tab { height: 40px; padding-left: 16px; padding-right: 16px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: rgb(199, 199, 183); font-size: 18px; }
.tab.chosen { color: rgb(243, 234, 214); border-bottom-width: 2px; border-bottom-color: rgb(228, 185, 105); }
.settings-body { height: 420px; }
.settings-scroll { flex-grow: 1; }
.setting-row { flex-direction: row; align-items: center; min-height: 40px; }
.setting-label { flex-grow: 1; font-size: 18px; }
.setting-value { font-size: 16px; color: rgb(199, 199, 183); margin-right: 10px; }
.option { height: 34px; min-width: 70px; margin-left: 6px; padding-left: 10px; padding-right: 10px; background-color: rgba(35, 54, 59, 0.9); border-width: 1px; border-color: rgba(190, 161, 108, 0.45); border-radius: 3px; color: rgb(243, 234, 214); font-size: 16px; }
.option:hover { border-color: rgb(228, 185, 105); }
.option.chosen { border-color: rgb(228, 185, 105); background-color: rgba(228, 185, 105, 0.22); }
.option.conflict { border-color: rgb(241, 132, 108); color: rgb(241, 132, 108); }
.key-option { min-width: 96px; }

/* ---------- World overlays ---------- */

.hp { position: absolute; left: 0; top: 0; width: 72px; }
.hp-hull { height: 7px; }
.hp-crew { height: 3px; margin-top: 1px; }
.select-box { position: absolute; border-width: 1px; border-color: rgba(228, 185, 105, 0.9); background-color: rgba(228, 185, 105, 0.08); }

/* ---------- Player options ---------- */

.compact .res-label { display: none; }
.compact .command-label { display: none; }
.compact .wordmark-label { display: none; }
.contrast .bottom-band, .contrast .topbar, .contrast .herald-item, .contrast .popover, .contrast .tooltip, .contrast .modal { background-color: rgb(6, 10, 12); }
.contrast .small, .contrast .res-cap, .contrast .herald-sub, .contrast .card-stat-label, .contrast .tooltip-body, .contrast .help-line { color: rgb(236, 236, 228); }
.contrast .command { color: rgb(255, 255, 255); }

/* Labels inside buttons keep their own alignment instead of the button's centred text. */
.herald-title, .herald-sub, .menu-item-label, .res-label, .port-name, .unit-name { -unity-text-align: middle-left; }
.herald-key, .menu-item-value { -unity-text-align: middle-right; }
.unit-name { -unity-text-align: middle-center; }
