/* Morza Bogów – battle interface. Laid out on a 1920×1080 reference; the panel scales it uniformly. */

.hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: rgb(240, 228, 204);
    font-size: 17px;
}

.title {
    letter-spacing: 1.5px;
    -unity-font-style: normal;
    color: rgb(240, 201, 120);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.75);
}

.num {
    color: rgb(250, 240, 220);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.small { font-size: 13px; color: rgb(214, 196, 160); }
.muted { color: rgb(170, 150, 120); }
.warn { color: rgb(240, 160, 90); }
.bad { color: rgb(240, 110, 95); }
.good { color: rgb(170, 205, 110); }

/* ---------- Top bar ---------- */

.topbar {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 58px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(34, 17, 10, 0.93);
    background-repeat: repeat repeat;
    background-size: 128px 128px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 21, 18);
}

.topbar-ornament {
    position: absolute;
    left: 0; right: 0; bottom: -11px;
    height: 11px;
}

.group {
    flex-direction: row;
    align-items: center;
    margin-right: 22px;
}

.group-text { margin-left: 8px; }

.big { font-size: 24px; -unity-font-style: bold; }
.mid { font-size: 18px; }

.top-medallion { width: 42px; height: 42px; }
.res-meter { height: 5px; width: 92px; margin-top: 2px; }

.divider {
    width: 1px;
    height: 34px;
    margin-left: 4px;
    margin-right: 20px;
    background-color: rgba(199, 155, 90, 0.35);
}

.spacer { flex-grow: 1; }

.icon-button {
    width: 38px;
    height: 38px;
    margin-left: 6px;
    border-radius: 19px;
}

.speed-label {
    width: 46px;
    -unity-text-align: middle-center;
    font-size: 19px;
}

/* ---------- Herald ---------- */

.herald {
    position: absolute;
    top: 76px;
    right: 16px;
    width: 410px;
    flex-direction: column;
}

.herald-item {
    flex-direction: row;
    align-items: center;
    min-height: 46px;
    margin-bottom: 8px;
    padding: 6px 12px 6px 8px;
    background-color: rgba(230, 211, 168, 0.95);
    background-repeat: repeat repeat;
    background-size: 256px 256px;
    border-left-width: 6px;
    border-left-color: rgb(140, 106, 59);
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    color: rgb(28, 21, 18);
    font-size: 16px;
}

.herald-item.important { border-left-color: rgb(217, 164, 65); }
.herald-item.critical { border-left-color: rgb(184, 50, 42); background-color: rgba(240, 218, 196, 0.97); }
.herald-text { flex-shrink: 1; flex-grow: 1; white-space: normal; color: rgb(28, 21, 18); text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.herald-seal { width: 32px; height: 32px; margin-right: 10px; flex-shrink: 0; }

/* ---------- Bottom dock ---------- */

.dock {
    position: absolute;
    left: 12px; right: 12px; bottom: 10px;
    height: 220px;
    flex-direction: row;
    align-items: flex-end;
}

.panel {
    height: 100%;
    margin-right: 10px;
    padding: 14px 14px 12px 14px;
    background-color: rgba(78, 37, 21, 0.94);
    background-repeat: repeat repeat;
    background-size: 128px 128px;
    border-radius: 3px;
}


.panel-frame {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.panel-title {
    font-size: 15px;
    margin-bottom: 6px;
}

.map-panel { width: 330px; }
.selection-panel { flex-grow: 1; flex-shrink: 1; }
.yard-panel { width: 420px; }
.orders-panel { width: 324px; margin-right: 0; }

.minimap {
    flex-grow: 1;
    border-width: 1px;
    border-color: rgb(28, 21, 18);
}

/* ---------- Selection card ---------- */

.card-row { flex-direction: row; align-items: center; }
.card-portrait { width: 112px; height: 112px; margin-right: 16px; flex-shrink: 0; }
.card-body { flex-grow: 1; flex-shrink: 1; }
.card-name { font-size: 22px; margin-bottom: 4px; }
.card-line { flex-direction: row; align-items: center; margin-top: 5px; }
.card-icon { width: 24px; height: 24px; margin-right: 6px; }
.card-meter { height: 12px; flex-grow: 1; margin-left: 8px; margin-right: 8px; }
.card-value { min-width: 84px; -unity-text-align: middle-right; }
.card-stat { flex-direction: row; align-items: center; margin-right: 18px; }
.card-order {
    margin-top: 8px;
    white-space: normal;
    color: rgb(240, 201, 120);
    font-size: 16px;
}

.help-line { white-space: normal; font-size: 15px; color: rgb(214, 196, 160); margin-top: 6px; }
.help-key { color: rgb(240, 201, 120); }

.group-grid { flex-direction: row; flex-wrap: wrap; }
.group-cell { width: 58px; height: 70px; margin-right: 6px; margin-bottom: 4px; align-items: center; }
.group-medallion { width: 52px; height: 52px; }
.group-meter { width: 46px; height: 5px; margin-top: 3px; }

/* ---------- Shipyard ---------- */

.yard-line { flex-direction: row; align-items: center; height: 76px; }
.yard-label { width: 66px; align-items: center; }
.yard-label-icon { width: 30px; height: 30px; }
.yard-current { width: 70px; height: 70px; margin-right: 10px; }
.yard-info { width: 118px; }
.yard-next { width: 40px; height: 40px; margin-right: 4px; }
.yard-empty { color: rgb(170, 150, 120); font-size: 15px; }

/* ---------- Orders ---------- */

.order-grid { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; }

.slot {
    width: 70px;
    height: 54px;
    margin-right: 4px;
    margin-bottom: 4px;
    align-items: center;
    justify-content: flex-start;
}

.slot-medallion { width: 42px; height: 42px; }
.slot-key {
    position: absolute;
    right: 6px; top: -2px;
    font-size: 12px;
    color: rgb(240, 201, 120);
    -unity-font-style: bold;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.9);
}
.slot-cost { font-size: 11px; color: rgb(230, 214, 180); margin-top: -2px; }
.slot.disabled .slot-cost { color: rgb(200, 110, 90); }

/* ---------- World overlays ---------- */

.world-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.hp {
    position: absolute;
    left: 0; top: 0;
    width: 72px;
}

.hp-hull { height: 7px; }
.hp-crew { height: 3px; margin-top: 1px; }

.select-box {
    position: absolute;
    border-width: 1px;
    border-color: rgba(240, 201, 120, 0.9);
    background-color: rgba(240, 201, 120, 0.08);
}

.mode-hint {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 4px 10px 4px 6px;
    background-color: rgba(28, 21, 18, 0.85);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(140, 106, 59);
    font-size: 15px;
}

.mode-hint-icon { width: 26px; height: 26px; margin-right: 6px; }

.tooltip {
    position: absolute;
    width: 330px;
    padding: 10px 14px 10px 14px;
    background-color: rgb(237, 230, 214);
    background-repeat: repeat repeat;
    background-size: 256px 256px;
    border-width: 2px;
    border-color: rgb(140, 106, 59);
    border-radius: 3px;
    color: rgb(28, 21, 18);
}

.tooltip-title { font-size: 18px; color: rgb(74, 36, 22); margin-bottom: 4px; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.tooltip-body { white-space: normal; font-size: 15px; color: rgb(28, 21, 18); }
.tooltip-cost { margin-top: 6px; font-size: 15px; color: rgb(122, 58, 32); -unity-font-style: bold; }
.tooltip-key { margin-top: 4px; font-size: 13px; color: rgb(110, 90, 60); }

.pause-banner {
    position: absolute;
    top: 82px;
    left: 0; right: 0;
    align-items: center;
}

.pause-card {
    padding: 6px 40px 8px 40px;
    background-color: rgba(28, 21, 18, 0.88);
    border-width: 1px;
    border-color: rgb(140, 106, 59);
    align-items: center;
}

.pause-text { font-size: 26px; letter-spacing: 8px; }
.pause-band { width: 220px; height: 9px; }

.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 6, 3, 0.55);
}

.dialog {
    width: 560px;
    padding: 26px 32px 24px 32px;
    background-color: rgb(78, 37, 21);
    background-repeat: repeat repeat;
    background-size: 128px 128px;
    align-items: center;
}

.dialog-title { font-size: 40px; letter-spacing: 6px; margin-bottom: 8px; }
.dialog-text { white-space: normal; -unity-text-align: middle-center; margin-bottom: 18px; }

.text-button {
    min-width: 200px;
    height: 44px;
    margin: 6px;
    padding-left: 20px;
    padding-right: 20px;
    justify-content: center;
    align-items: center;
    background-color: rgb(140, 106, 59);
    border-width: 2px;
    border-color: rgb(28, 21, 18);
    border-radius: 3px;
    color: rgb(28, 21, 18);
    font-size: 18px;
}

.text-button:hover { background-color: rgb(217, 164, 65); }
.text-button.chosen { background-color: rgb(240, 201, 120); border-color: rgb(250, 240, 220); }

.settings-columns { flex-direction: row; }
.settings-column { width: 240px; margin-left: 10px; margin-right: 10px; align-items: stretch; }
