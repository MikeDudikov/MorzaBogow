    "legacy": {
      "harbor.sourceApproachSeconds": {
        "value": 2,
        "why": "model abstraction of coming alongside a deposit. The game has no such number; what it does have at a deposit, the crew going ashore and coming back aboard, is in the export and left out (see UNUSED_EXPORT)"
      },
      "harbor.turnaroundSeconds": {
        "value": 2,
        "why": "model abstraction of leaving a berth of the port; the game has no such number"
      }
    },
    "notInExport": {
      "start.collectors": {
        "value": [
          3,
          1
        ],
        "source": "Assets/MorzaBogow/Runtime/Simulation/MapFactory.cs:214-220",
        "note": "A value of the game (E04: three boats on wood and one on silver from the first moment), not exported."
      },
      "homePointsPerResource": {
        "value": 1,
        "source": "Assets/MorzaBogow/Runtime/Simulation/MapFactory.cs:211-212",
        "note": "The export gives the deposit of one point; the number of points on a map is only in MapFactory."
      }
    },
    "unusedExport": {
      "rules.node.landCrewSeconds": {
        "value": 3,
        "why": "A boat at a deposit first puts its crew ashore, with no work meanwhile (Definitions.cs:308-313). Left out: the model has its own two seconds of approach instead (harbor.sourceApproachSeconds, LEGACY)."
      },
      "rules.node.embarkSeconds": {
        "value": 4,
        "why": "After the last load the boat waits for its crew and keeps the berth (Definitions.cs:308-313). Left out. With landCrewSeconds this is about 7 s more a visit to a deposit than the model counts, so the model reads incomes somewhat high, most of all on short runs and at a crowded deposit."
      }
    },
